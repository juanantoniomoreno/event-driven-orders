# Event-Driven Orders — Environment Variables Template
# =====================================================
# Copy this file to `.env` and fill in real values for your local dev setup.
# `.env` is gitignored. `.env.example` is the public, secret-free template.
#
# In production, override these via a secrets manager (Docker Secrets, Vault,
# AWS Secrets Manager, etc.) and never commit real credentials.

# --- Mercure Hub (SSE real-time hub) -----------------------------------------
# Shared secret used by Symfony and Docker. Generate one with:
#   openssl rand -hex 32
# In dev, publisher and subscriber can share the same key.
# In production, use separate keys so a leaked subscriber key cannot publish.
MERCURE_JWT_SECRET=replace_me_with_64_char_hex_from_openssl_rand_hex_32

# --- RabbitMQ (message broker, Phase 5) --------------------------------------
# Dev defaults. Change in production.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# --- PostgreSQL (Phase 4) ----------------------------------------------------
# Dev defaults. Change in production.
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders
