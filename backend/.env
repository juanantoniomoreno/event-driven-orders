APP_ENV=dev
APP_SECRET=changeme_in_production_please
# Mercure Hub
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3001/.well-known/mercure

# Mercure JWT keys
# In development publisher and subscriber use the same key.
# In production, use separate keys — if a subscriber key leaks, attackers can't publish.
DEFAULT_URI=http://localhost


